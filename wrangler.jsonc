{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "alex-dytrych",
    "main": "worker/index.ts",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        // Serve cv.html at /cv, and redirect /cv/ to /cv.
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        // These paths come from other repos. The Worker proxies them (see worker/index.ts).
        // All other requests go directly to the static files, and the Worker does not run.
        "run_worker_first": ["/toys", "/toys/*", "/tentacles", "/tentacles/*"],
    },
    "observability": { "enabled": true },
    // Uncomment at cutover. Remove the existing alex.dytry.ch DNS record first.
    // "routes": [{ "pattern": "alex.dytry.ch", "custom_domain": true }],
}
