{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "alex-dytrych",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "./dist",
        // Serve cv.html at /cv, and redirect /cv/ to /cv.
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
    },
    "observability": { "enabled": true },
    "routes": [{ "pattern": "alex.dytry.ch", "custom_domain": true }],
    // Keep alex-dytrych.somehats.workers.dev, and preview URLs for branch builds.
    "workers_dev": true,
}
