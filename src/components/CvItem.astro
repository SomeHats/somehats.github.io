---
interface Props {
    date: string;
}

const { date } = Astro.props;
---

<article class="CvItem">
    <header class="CvItem-head">
        <h5 class="CvItem-name">
            <slot name="name" />
        </h5>
        <time class="CvItem-date">{date}</time>
    </header>
    <div class="CvItem-desc">
        <slot />
    </div>
</article>

<style>
    .CvItem {
        padding-bottom: 1rem;
        break-inside: avoid;
    }
    .CvItem-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
    }
    .CvItem-name {
        margin-bottom: 0;
        margin-right: 1rem;
        flex: 1 0 auto;
        max-width: 100%;
    }
    .CvItem-date {
        font-family: var(--font-heading);
        font-weight: 400;
        display: block;
        flex: 0 1 auto;
        opacity: 0.5;
        font-style: italic;
    }
    .CvItem-desc {
        clear: both;
        margin-bottom: 1rem;
        text-align: justify;
    }
</style>
