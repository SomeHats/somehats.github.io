---
interface Props {
    href: string;
    class?: string;
}

const { href, class: className } = Astro.props;
// At build time the path is the output file, for example "/cv.html" or "/index.html".
const path = Astro.url.pathname.replace(/(\/index)?(\.html)?\/?$/, "") || "/";
const isActive = path === href;
---

<a href={href} class:list={["NavLink", className, { "NavLink--active": isActive }]}>
    <span class="NavLink-text">
        <slot />
    </span>
</a>

<style>
    .NavLink {
        font-family: var(--font-heading);
        font-weight: 400;
        cursor: pointer;
        display: inline-block;
        font-size: 1.5rem;
        text-decoration: none;
        color: var(--primary);
    }
    .NavLink--active {
        color: var(--text);
    }
    .NavLink-text {
        display: inline-block;
        transition: transform 0.2s ease;
        width: auto;
    }
    .NavLink:not(.NavLink--active):hover .NavLink-text {
        transform: translateY(-0.2rem);
    }
</style>
