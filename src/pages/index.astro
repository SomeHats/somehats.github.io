---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import profile from "../assets/profile.jpg";
---

<Layout title="Alex Dytrych">
    <article class="Home">
        <h1 class="Home-heading">Hello! I’m Alex.</h1>
        <div class="Home-content">
            <section class="Home-lead">
                <h2 class="Home-tagline">I make things for people who make things.</h2>
                <figure class="Home-profilePic">
                    <Picture
                        src={profile}
                        alt="A person in a purple cap, with mountains in the distance"
                        class="Home-profileImg"
                        formats={["avif", "webp"]}
                        widths={[300, 450, 600, 900]}
                        sizes="(max-width: 500px) 100vw, (max-width: 850px) 40vw, 300px"
                        priority
                    />
                    <figcaption class="Home-profilePicCaption">
                        In my natural habitat, up some mountain.
                    </figcaption>
                </figure>
            </section>
            <section class="Home-bio">
                <p>
                    I’m a product engineer with over 12 years of experience building creative tools,
                    apps, and games for the web. Good tools (and the skills to go with them) feel
                    like superpowers. Giving people that feeling is what drives my work.
                </p>
                <p>
                    At previous employers like{" "}
                    <a class="Link" href="https://tldraw.dev">
                        tldraw
                    </a>{" "}
                    and{" "}
                    <a class="Link" href="https://airtable.com">
                        Airtable
                    </a>
                    , I’ve worked on everything from{" "}
                    <a class="Link" href="https://x.com/tldraw/status/1747625230036529643">
                        AI
                    </a>{" "}
                    <a class="Link" href="https://computer.tldraw.com/">
                        prototypes
                    </a>
                    ,{" "}
                    <a class="Link" href="https://x.com/SomeHats/status/1656605608844435456">
                        canvas
                    </a>{" "}
                    <a class="Link" href="https://x.com/SomeHats/status/1896986654923219093">
                        interactions
                    </a>
                    , and drag-and-drop{" "}
                    <a class="Link" href="https://www.airtable.com/platform/interface-designer">
                        UI builders
                    </a>{" "}
                    to{" "}
                    <a class="Link" href="https://tldraw.dev/quick-start">
                        developer SDKs
                    </a>
                    ,{" "}
                    <a
                        class="Link"
                        href="https://medium.com/airtable-blog/creating-a-scripting-environment-for-airtable-that-anyone-can-use-21a43e5de841"
                    >
                        scripting
                    </a>{" "}
                    <a class="Link" href="https://airtable.com/developers/scripting">
                        environments
                    </a>
                    , and{" "}
                    <a class="Link" href="https://tldraw.dev/docs/sync">
                        sync engines
                    </a>
                    .
                </p>
                <p>
                    A long time ago, I founded{" "}
                    <a class="Link" href="https://eraseallkittens.com">
                        Erase All Kittens
                    </a>
                    , an award-winning game that has introduced hundreds of thousands of children
                    aged 8+ to coding. You should have a go!
                </p>
                <p>
                    As a teacher &amp; facilitator, I’ve designed degree-level software engineering
                    courses, taught business executives to build IoT devices, and introduced
                    7-year-olds to game design.
                </p>
                <p>
                    Hire me to help build your cool internet thing. I like figuring out who it’s
                    for, what it should be, how it feels, the plumbing inside, and everything else.{" "}
                    <a class="Link" href="/contact">
                        Get in touch
                    </a>
                    !
                </p>
            </section>
        </div>
    </article>
</Layout>

<style>
    .Home-content {
        display: flex;
    }
    .Home-heading {
        padding-top: 2rem;
    }
    .Home-tagline {
        font-size: 1.3rem;
    }
    .Home-lead {
        width: 33%;
        margin-right: 3rem;
        flex: 0 0 auto;
    }
    .Home-profilePic {
        padding-top: 1rem;
        margin: 0;
    }
    .Home-profilePic :global(.Home-profileImg) {
        max-width: 100%;
        height: auto;
    }
    .Home-profilePicCaption {
        font-family: var(--font-heading);
        font-weight: 300;
        font-style: italic;
        opacity: 0.6;
        font-size: 0.7rem;
        text-align: center;
        margin: 0 1rem;
    }
    .Home-bio {
        text-align: justify;
        display: block;
    }
    @media screen and (max-width: 500px) {
        .Home-content {
            flex-direction: column;
        }
        .Home-lead {
            width: 100% !important;
            margin-bottom: 1rem;
        }
    }
    @media screen and (max-width: 600px) {
        .Home-heading {
            padding-top: 0;
        }
    }
    @media screen and (max-width: 850px) {
        .Home-lead {
            width: 40%;
            margin-right: 2rem;
        }
    }
</style>
