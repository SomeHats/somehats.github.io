---
import { Picture } from "astro:assets";
import CvItem from "../components/CvItem.astro";
import EmailLink from "../components/EmailLink.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import profile from "../assets/profile.jpg";

const contacts = [
    { href: "https://alex.dytry.ch", icon: "web", title: "Website", text: "alex.dytry.ch" },
    { href: "https://github.com/somehats", icon: "github", title: "GitHub", text: "SomeHats" },
    { href: "https://x.com/somehats", icon: "x", title: "X", text: "@SomeHats" },
] as const;
---

<Layout title="CV | Alex Dytrych">
    <article class="Cv">
        <header class="CvHeader">
            <section class="CvHeader-nameSection">
                <h1>Alex Dytrych</h1>
                <h2 class="CvHeader-jobTitle">
                    Staff product engineer
                    <br /> Interaction designer
                </h2>
                <p class="CvHeader-locationUpdate">She/her • Remote, NZ • Updated November 2026</p>
            </section>
            <!-- <section class="CvHeader-imageSection">
                {/* Not `priority`: the CV hides this image on narrow screens, where an eager image would still download. */}
                <Picture
                    src={profile}
                    alt=""
                    class="CvHeader-profilePicture"
                    formats={["avif", "webp"]}
                    widths={[180, 360, 540]}
                    sizes="180px"
                />
            </section> -->
            <section class="CvHeader-contactSection">
                <ul class="CvContact">
                    <li class="CvContactItem" data-email-container hidden>
                        <EmailLink class="CvContactItem-link" title="Email" />
                        <Icon name="email" class="CvContactItem-icon" />
                    </li>
                    {contacts.map((item) => (
                        <li class="CvContactItem">
                            <a class="Link CvContactItem-link" href={item.href} title={item.title}>
                                {item.text}
                            </a>
                            <Icon name={item.icon} class="CvContactItem-icon" />
                        </li>
                    ))}
                </ul>
            </section>
        </header>

        <section class="CvSummary">
            <p>
                <strong>I make things for people who make things.</strong>
            </p>
            <p>
                I'm a staff product engineer with 13 years of experience building creative tools and
                developer platforms at companies like tldraw and Airtable. I work across the whole
                product, from who it's for and what it should be, to how it feels and the plumbing
                inside. Good tools feel like superpowers. Giving people that feeling is what drives
                my work.
            </p>
        </section>

        <section class="CvSection">
            <h3>Work History</h3>

            <CvItem date="January 2023 - October 2025">
                <Fragment slot="name">
                    Staff Product Engineer •{" "}
                    <a class="Link" href="https://tldraw.dev">
                        tldraw
                    </a>
                </Fragment>
                <p>
                    tldraw makes an infinite-canvas SDK used by teams like Autodesk, ClickUp, and
                    Mobbin. I joined as the fifth hire and owned work across the canvas, SDK,
                    releases, support, and product.
                </p>
                <ul>
                    <li>
                        Point person for SDK design. Designed APIs every tldraw app builds on,
                        including shape relationships, custom styles, snapping, undo/redo, and image
                        exports. Built canvas features alongside them, such as elbow arrows and the
                        highlighter.
                    </li>
                    <li>
                        Ran the SDK's regular releases, including 4.0, and wrote most of the release
                        notes. Stayed in constant contact with customers on Discord and GitHub to
                        get them unblocked and inform what we needed to build in the SDK next.
                    </li>
                    <li>
                        Led our most-requested feature, multiplayer sync, from internal code to
                        product. I defined what the product should be, designed the public API and
                        extension points, and shipped it with hosting templates and docs. Customers
                        used it to replace in-house sync and ship new multiplayer features.
                    </li>
                    <li>
                        Built early AI-on-canvas experiments, from prototypes (agents drawing
                        directly on the canvas in 2023) to public launches such as tldraw computer,
                        teach and draw fast.
                    </li>
                    <li>
                        Ran the starter kits initiative to get people building on the SDK faster: I
                        built npm create tldraw, the most-requested starter kits (workflows, chat,
                        multiplayer), and set up the process for other team members to contribute
                        kits easily.
                    </li>
                    <li>
                        Managed external contractors, and stepped in to get a partner project with
                        an external agency and major cloud provider back on track.
                    </li>
                </ul>
            </CvItem>

            <CvItem date="January 2019 - July 2022">
                <Fragment slot="name">
                    Staff Product Engineer •{" "}
                    <a class="Link" href="https://airtable.com">
                        Airtable
                    </a>
                </Fragment>
                <p>
                    My role grew and changed with the company as it scaled from 70 to over 1,000
                    people.
                </p>
                <ul>
                    <li>
                        Tech lead on the platform and ecosystem team. I developed our ecosystem
                        strategy, led the team to ship our third-party extension tools and
                        marketplace, and coordinated a group of external contractors.
                    </li>
                    <li>
                        Created Airtable's scripting environment. My initial idea and one-week
                        prototype proved popular with users and internal stakeholders, and scripting
                        became a key priority as the company stepped from no-code to low-code.{" "}
                        <a class="Link" href="https://alex.dytry.ch/creating-scripting">
                            Read more
                        </a>
                        .
                    </li>
                    <li>
                        Delivered customer training webinars on our developer tools, and spoke at
                        AWS re:Invent 2020 about how we run untrusted scripts safely.
                    </li>
                    <li>
                        One of three founding engineers on Interface Designer, a major 0→1
                        initiative to build the third pillar of Airtable's product strategy after
                        data and automations. I designed and built the drag-and-drop layout builder
                        at the core of the product.
                    </li>
                    <li>
                        After the launch of interface designer, we rolled out a number of tooling
                        and process improvements from the project to the whole engineering org.
                    </li>
                </ul>
            </CvItem>

            <CvItem date="October 2025 - Present">
                <Fragment slot="name">Sabbatical and freelance</Fragment>
                <p>
                    A year in New Zealand's mountains. Part-time R&D for friends' startups on AI
                    agents, realtime partial sync for SQLite, mobile app prototypes, and building
                    with agentic coding tools.
                </p>
            </CvItem>

            <CvItem>
                <Fragment slot="name">Earlier</Fragment>
                <ul style="text-align: left">
                    <li>
                        <strong>Consultant product engineer and facilitator, 2017–2019</strong>. A
                        one-person product shop, taking UK non-profits from rough idea to tested
                        MVP.
                    </li>
                    <li>
                        <strong>
                            Software Engineer,{" "}
                            <a class="Link" href="https://www.musicglue.com/">
                                Music Glue
                            </a>
                            , 2016–2017
                        </strong>
                        . Rebuilt the e-commerce platform as Node.js services behind a single
                        GraphQL API, with a fast React storefront.
                    </li>
                    <li>
                        <strong>
                            Co-founder and CTO,{" "}
                            <a class="Link" href="https://eraseallkittens.com/">
                                Erase All Kittens
                            </a>
                            , 2013–2016
                        </strong>
                        . Created an award-winning game where children edit a level's HTML and CSS
                        as they play. It is still active and has introduced hundreds of thousands of
                        children to coding.
                    </li>
                    <li>
                        <strong>
                            Developer,{" "}
                            <a class="Link" href="https://decoded.com/">
                                Decoded
                            </a>
                            , 2013–2014
                        </strong>
                        . Designed workshops &amp; built the live coding environment used in every
                        Decoded workshop.
                    </li>
                </ul>
            </CvItem>

            <CvItem>
                <Fragment slot="name">Teaching &amp; facilitating</Fragment>
                <p>
                    Before I got obsessed with building tools that let people be creative with
                    computers, my focus was on teaching the skills to do so instead. I've designed
                    and taught a degree-level software engineering bootcamp whose graduates joined
                    Google, Meta and EY, taught business executives to build IoT devices, and
                    introduced 7-year-olds to game design. Co-author of JavaScript Made Easy (DK,
                    2018).
                </p>
            </CvItem>
        </section>
    </article>
</Layout>

<style>
    .CvHeader {
        display: flex;
    }
    .CvHeader-nameSection {
        order: 1;
        flex: 1 1 auto;
    }
    .CvHeader-imageSection {
        order: 0;
        margin-right: 2rem;
        flex: 0 0 10rem;
    }
    .CvHeader-imageSection :global(.CvHeader-profilePicture) {
        max-width: 100%;
        height: auto;
        border-radius: 100%;
    }
    .CvHeader-contactSection {
        order: 2;
        flex: 0 0 12rem;
    }
    .CvHeader-jobTitle {
        font-size: 1rem;
        margin: 1rem 0;
    }
    .CvHeader-locationUpdate {
        font-family: var(--font-heading);
        font-weight: 400;
        font-style: italic;
        /* Not opacity: in a PDF, it puts the text out of reading order. */
        color: color-mix(in srgb, var(--text) 50%, var(--bg));
        font-size: 0.8rem;
    }

    .CvContact {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: right;
    }
    .CvContactItem {
        color: var(--primary-dark);
        margin: 0.5rem 0;
    }
    .CvContactItem :global(.CvContactItem-link) {
        display: inline-block;
        margin: 0 1rem;
    }
    .CvContactItem :global(a.CvContactItem-link)::after {
        display: none;
    }
    .CvContactItem :global(.CvContactItem-icon) {
        margin-top: -0.2rem;
        width: 1.8rem;
        height: 1.8rem;
    }

    .CvSummary {
        padding-top: 1.5rem;
        text-align: justify;
    }
    .CvSection {
        padding-top: 1rem;
    }

    @media screen and (max-width: 600px) {
        .CvHeader {
            display: block;
        }
        .CvContact {
            text-align: left;
        }
        .CvContactItem {
            display: flex;
        }
        .CvContactItem :global(.CvContactItem-link) {
            order: 1;
        }
        .CvContactItem :global(.CvContactItem-icon) {
            order: 0;
        }
    }
    @media screen and (max-width: 950px) {
        .CvHeader-imageSection {
            display: none;
        }
    }
</style>
