{
    "name": "dytry.ch",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro build && wrangler dev",
        "deploy": "pnpm check && astro build && wrangler deploy",
        "check": "astro sync && tsc --noEmit --runExternalCode",
        "format": "prettier --write ."
    },
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "astro": "^7.4.5"
    },
    "devDependencies": {
        "@astrojs/ts-content-mapper": "^0.2.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "sharp": "^0.35.5",
        "typescript": "7.1.0-beta",
        "wrangler": "^4.157.0"
    }
}
